RunService.RenderStepped:Connect(function()
    if CameraSettings.FOVEnabled then
         workspace.CurrentCamera.FieldOfView = CameraSettings.FOVValue
    end

    if WorldSettings.Fullbright then
          Lighting.Brightness = 2
         Lighting.ClockTime = 14
         Lighting.FogEnd = 100000
         Lighting.GlobalShadows = false
         Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    end

    if SpeedSettings.Enabled and LP.Character and LP.Character:FindFirstChild("Humanoid") and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hum = LP.Character.Humanoid
        local root = LP.Character.HumanoidRootPart
        
        if hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (SpeedSettings.SpeedValue / 50))
         end
    end

    if AimSettings.ShowFOV then
         
        FOVFrame.Visible = true
        local diameter = AimSettings.FOV * 2
        FOVFrame.Size = UDim2.new(0, diameter, 0, diameter)
       
        local _, yOffset = GetFOVCenter()
         FOVFrame.Position = UDim2.new(0.5, 0, 0.5, yOffset)

         if CameraSettings.RainbowFOV then
            local hue = tick() % 5 / 5
             UIStroke.Color = Color3.fromHSV(hue, 1, 1)
         else
             UIStroke.Color = CameraSettings.FOVColor
           end
    else
           FOVFrame.Visible = false
    end

     local enemyTarget = GetTargetV2()
     local allyTarget = nil
    
    if MedicSettings.AutoHealAlly then
         allyTarget = GetAllyTargetInFOV()
     end
   
    local uiTarget = enemyTarget or allyTarget

    local localHead = LP.Character and LP.Character:FindFirstChild("Head")
    local flashState = (math.sin(tick() * 15) > 0)
    
     for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= LP and p.Character then
              local highlight = p.Character:FindFirstChild("ESPHighlight")
         
            local nameGuiTop = p.Character:FindFirstChild("NameESP_Top")
            local nameGuiBottom = p.Character:FindFirstChild("NameESP_Bottom")
         
             local labelTop = nameGuiTop and nameGuiTop:FindFirstChild("TextLabel")
             local labelBottom = nameGuiBottom and nameGuiBottom:FindFirstChild("TextLabel")
        
             local hum = p.Character:FindFirstChildOfClass("Humanoid")
         
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            
             if highlight and labelTop and labelBottom and hum then
                local isDead = (hum.Health <= 0)
                
                 if p.Character:FindFirstChildOfClass("ForceField") then
                     PlayerDeathCounts[p.UserId] = 0
                     PlayerAliveStates[p.UserId] = true
                     isDead = false
                 end
                
                 if PlayerAliveStates[p.UserId] == nil then
                     PlayerAliveStates[p.UserId] = not isDead
                 end
                
                 if PlayerAliveStates[p.UserId] and isDead then
                    PlayerDeathCounts[p.UserId] = (PlayerDeathCounts[p.UserId] or 0) + 1
                    PlayerAliveStates[p.UserId] = false
                 elseif not isDead then
                    PlayerAliveStates[p.UserId] = true
                 end

                 local deadColor = Color3.fromRGB(40, 5, 5) 
                
                if isDead then
                   local deaths = PlayerDeathCounts[p.UserId] or 1
                     if p.Team == LP.Team then
                        if deaths == 1 then deadColor = Color3.fromRGB(255, 0, 0)
                          else deadColor = Color3.fromRGB(0, 0, 0) end
                     else
                        if deaths == 1 then deadColor = Color3.fromRGB(255, 165, 0)
                         else deadColor = Color3.fromRGB(255, 255, 255) end
                     end
                end
            
                 local baseColor = p.TeamColor.Color
                 if AimSettings.UseCustomESPColors then
                      baseColor = (p.Team == LP.Team) and AimSettings.AllyESPColor or AimSettings.EnemyESPColor
                 end

                 local targetHighlightColor = isDead and deadColor or baseColor
                 local targetNameColor = isDead and deadColor or baseColor
  
                if not isDead and uiTarget and uiTarget.Parent == p.Character then
                       if p.Team == LP.Team then
                          targetNameColor = AimSettings.UseCustomESPColors and AimSettings.AllyESPColor or Color3.fromRGB(0, 255, 0)
                     else
                         targetNameColor = AimSettings.UseCustomESPColors and AimSettings.EnemyESPColor or Color3.fromRGB(255, 0, 0)
                      end
                   end
       
                 if not isDead and AimSettings.EnemyLookWarning and p.Team ~= LP.Team and localHead then
                     local enemyHead = p.Character:FindFirstChild("Head")
                    if enemyHead then
                             local dirToLP = (localHead.Position - enemyHead.Position).Unit
                         local enemyLook = enemyHead.CFrame.LookVector
                        if enemyLook:Dot(dirToLP) >= 0.9781 then 
                               if not AimSettings.WallCheck or IsVisible(enemyHead) then
                                   if flashState then
                                        targetHighlightColor = Color3.fromRGB(255, 0, 0)
                                        targetNameColor = Color3.fromRGB(255, 0, 0)
                                 end
                               end
                            end
                    end
                 end
    
                    highlight.FillColor = targetHighlightColor
                  
                  labelTop.TextColor3 = targetNameColor
                 labelTop.TextSize = AimSettings.NameESPSize
        
                  labelTop.Visible = AimSettings.ShowNames and AimSettings.ESPEnabled

                   labelBottom.TextColor3 = targetNameColor
                  labelBottom.TextSize = AimSettings.NameESPSize
                  labelBottom.Visible = AimSettings.ShowNames and AimSettings.ESPEnabled

                    if AimSettings.ShowNames and AimSettings.ESPEnabled then
                       local moveState = ""
          
                     if not isDead and root then
                          local currentSpeed = math.sqrt(root.AssemblyLinearVelocity.X^2 + root.AssemblyLinearVelocity.Z^2)
                          if currentSpeed > 16 then
                             moveState = "[Running] "
                          elseif currentSpeed >= 0.5 then
                              moveState = "[Walking] "
                            end
                      end

                     local dist = 0
                     if root and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                         dist = (LP.Character.HumanoidRootPart.Position - root.Position).Magnitude
                      end
                     
                     local teamName = (p.Team and p.Team.Name) or "Neutral"
                     
                     local deadTag = ""
   
                     if isDead then
                          local deaths = PlayerDeathCounts[p.UserId] or 1
                         if deaths == 1 then
                             deadTag = " [Downed]"
                          else
                             deadTag = " [Dead]"
                          end
                     end
                     
                      local currentHP = math.max(0, math.floor(hum.Health))
             
                        if moveState ~= "" then
                          labelTop.Text = string.format("%s[HP: %d] [%s]", moveState, currentHP, teamName)
                     else
                          labelTop.Text = string.format("[HP: %d] [%s]", currentHP, teamName)
                      end
                      
                      labelBottom.Text = string.format("%s%s\n[%.1f Studs]", p.Name, deadTag, dist)
                  end
                 end
         end
     end

    if enemyTarget and AimSettings.SilentAimV2Enabled then
        local MyOrigin = LP.Character and (LP.Character:FindFirstChild("Head") or LP.Character.PrimaryPart)
         local dist = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (LP.Character.HumanoidRootPart.Position - enemyTarget.Position).Magnitude) or 999
        
          if dist <= AimSettings.SilentAimV2MaxDistance and MyOrigin then
              CurrentSilentAimV2Target = enemyTarget
           else
                CurrentSilentAimV2Target = nil
        end
     else
          CurrentSilentAimV2Target = nil
    end

    if uiTarget then
         if AimSettings.ShowTargetInfo and uiTarget.Parent:FindFirstChild("Humanoid") then
             local hum = uiTarget.Parent.Humanoid
             TargetHud.Adornee = uiTarget
                 TargetHud.Enabled = true
             
              local distance = 0
             if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                distance = (LP.Character.HumanoidRootPart.Position - uiTarget.Position).Magnitude
             end

             local targetPlayer = game.Players:GetPlayerFromCharacter(uiTarget.Parent)
              
            if AimSettings.ShowNames and AimSettings.ESPEnabled then
                  TargetInfoLabel.TextSize = 10
                  TargetHud.ExtentsOffset = Vector3.new(0, 10, 0)
                  TargetInfoLabel.Text = "" 
                 else
                  TargetInfoLabel.TextSize = 14
                  TargetHud.ExtentsOffset = Vector3.new(0, 3, 0)
                 if targetPlayer and targetPlayer.Team == LP.Team then
                         TargetInfoLabel.Text = string.format("[Ally] %s\nHP: %.0f / %.0f", uiTarget.Parent.Name, hum.Health, hum.MaxHealth)
                       else
                       TargetInfoLabel.Text = string.format("%s\nHP: %.0f / %.0f", uiTarget.Parent.Name, hum.Health, hum.MaxHealth)
                 end
               end
              TargetInfoLabel.TextColor3 = Color3.fromHSV(math.clamp(hum.Health/hum.MaxHealth, 0, 1) * 0.3, 1, 1)
          else
              TargetHud.Enabled = false
         end

         if enemyTarget then
             local targetPos = getSilentPos(enemyTarget)

              if AimSettings.Enabled then
                  local currentCF = Camera.CFrame
                   local aimCF = CFrame.lookAt(currentCF.Position, targetPos)
                  
                  local _, fovYOffset = GetFOVCenter()
                  if fovYOffset ~= 0 then
                       local fovRadians = math.rad(Camera.FieldOfView)
                       local pitchOffset = (fovYOffset / Camera.ViewportSize.Y) * fovRadians
                      aimCF = aimCF * CFrame.Angles(pitchOffset, 0, 0)
                  end

                   if AimSettings.StickyAimEnabled then
                       Camera.CFrame = aimCF
                  else
                      Camera.CFrame = currentCF:Lerp(aimCF, AimSettings.Smoothness)
                  end
              end

              if AimSettings.SilentAimEnabled and enemyTarget then
