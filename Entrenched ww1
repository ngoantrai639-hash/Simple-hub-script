local function UpdatePropESP(trackerDict, settingToggle, settingColor)
    for prop, data in pairs(trackerDict) do
        if not prop.Parent then
            if data.gui then data.gui:Destroy() end
            if data.highlight then data.highlight:Destroy() end
            trackerDict[prop] = nil
            continue
        end
        
        local isEnabled = AimSettings.ESPEnabled and settingToggle
        data.gui.Enabled = isEnabled
        data.highlight.Enabled = isEnabled
        
        if isEnabled then
            data.label.TextSize = AimSettings.NameESPSize
            data.highlight.FillTransparency = AimSettings.ESPTransparency
            data.label.Text = prop.Name
            data.label.TextColor3 = settingColor
            data.highlight.FillColor = settingColor
            
            local dist = 0
            if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                dist = (LP.Character.HumanoidRootPart.Position - prop:GetPivot().Position).Magnitude
            end
            
            if dist <= AimSettings.ESPShowRange then
                data.label.Visible = AimSettings.ShowNames
            else
                data.label.Visible = false
            end
        end
    end
end

