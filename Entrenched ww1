    if AimSettings.SilentAimV2Enabled and CurrentSilentAimV2Target then
        if method == "Raycast" then
            args[2] = (CurrentSilentAimV2Target.Position - args[1]).Unit * 500
            return oldNamecall(self, unpack(args))
        elseif method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay" then
            local origin = args[1].Origin
            args[1] = Ray.new(origin, (CurrentSilentAimV2Target.Position - origin).Unit * 500)
            return oldNamecall(self, unpack(args))
        end
    end

    return oldNamecall(self, ...)
end)
