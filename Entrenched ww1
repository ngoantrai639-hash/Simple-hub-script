			if (FlatIdent_25011 == 0) then
				currentProj = tool:GetAttribute("Projectiles");
				if (currentProj ~= nil) then
					tool:SetAttribute("OriginalProjectiles", currentProj);
				else
					tool:SetAttribute("OriginalProjectiles", 1);
				end
				break;
			end
		end
	end
	local originalProjCount = tool:GetAttribute("OriginalProjectiles");
	local target = GetTarget();
	local distToTarget = 200;
	if (target and LP.Character:FindFirstChild("HumanoidRootPart")) then
		distToTarget = (LP.Character.HumanoidRootPart.Position - target.Position).Magnitude;
	end
	local projCount = originalProjCount;
	if (target and (distToTarget <= 100)) then
		GunSettings.LastTargetTime = tick();
		projCount = GunSettings.ProjectilesValue;
	elseif ((tick() - GunSettings.LastTargetTime) > 0.15) then
		projCount = originalProjCount;
	else
		projCount = GunSettings.ProjectilesValue;
	end
	if GunSettings.VelocityEnabled then
		tool:SetAttribute("Velocity", GunSettings.VelocityValue);
