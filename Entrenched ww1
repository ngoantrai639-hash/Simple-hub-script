local s, wm = pcall(require, ReplicatedStorage:WaitForChild("WeaponModule"))
if s and wm then
     local oldEquip
    oldEquip = hookfunction(rawget(wm, "Equip"), newcclosure(function(data, _)
          if GunSettings.NoRecoilEnabled and data and data.Tool then
               data.Tool:SetAttribute("Recoil", 0)
            task.spawn(function()
                 while GunSettings.NoRecoilEnabled and data.RecoilPattern do
                    table.clear(data.RecoilPattern)
                       task.wait()
                     end
              end)
        end
          return oldEquip(data, _)
    end))

    local function GetTargetV3()
         if AimSettings.StickyAimEnabled and CurrentStickyTargetV3 then
             local hum = CurrentStickyTargetV3.Parent and CurrentStickyTargetV3.Parent:FindFirstChildOfClass("Humanoid")
             if hum and hum.Health > 0 then
                 local pos, onScreen = Camera:WorldToViewportPoint(CurrentStickyTargetV3.Position)
                if onScreen then
                    local center, _ = GetFOVCenter()
                    local magnitude = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                     if magnitude < AimSettings.FOV then
                         local distToPlayer = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (LP.Character.HumanoidRootPart.Position - CurrentStickyTargetV3.Position).Magnitude) or 999
                          if distToPlayer <= AimSettings.MaxDistance then
                              if not AimSettings.WallCheck or IsVisible(CurrentStickyTargetV3) then
                                  return CurrentStickyTargetV3
                              end
                           end
                    end
                end
             end
            CurrentStickyTargetV3 = nil
         end

           local target = nil
         local shortestDistance = AimSettings.FOV
         local center, _ = GetFOVCenter()

         for _, v in pairs(game.Players:GetPlayers()) do
              if v ~= LP and v.Character and v.Character:FindFirstChild(AimSettings.TargetPart) then
                   if v.Team == LP.Team then continue end
                    local hum = v.Character:FindFirstChildOfClass("Humanoid")
                if not hum then continue end
                if AimSettings.DeadCheck and hum.Health <= 0 then continue end
                 if AimSettings.ForcefieldCheck and v.Character:FindFirstChildOfClass("ForceField") then continue end

                  local part = v.Character[AimSettings.TargetPart]
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                  if onScreen then
                       local magnitude = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if magnitude < shortestDistance then
                              local distToPlayer = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (LP.Character.HumanoidRootPart.Position - part.Position).Magnitude) or 999
                           if distToPlayer <= AimSettings.MaxDistance then
                              if not AimSettings.WallCheck or IsVisible(part) then
                                          shortestDistance = magnitude
                                          target = part
                                end
                            end
                  end
                  end
            end
         end

         if target and AimSettings.StickyAimEnabled then
              CurrentStickyTargetV3 = target
             end

         return target
    end

     local anon = debug.getupvalue(rawget(wm, "Shoot"), 3)
    if not anon or type(anon) ~= "function" then
         for _, v in next, debug.getupvalues(rawget(wm, "Shoot")) do
             if type(v) == "function" then anon = v; break; end
        end
    end

    if anon then
        for k, v in next, getfenv(anon) do
            if type(v) == "function" then
                local n = debug.info(v, "n")
                if n == "Crosshair" then
                     local oldCrosshair
                    oldCrosshair = hookfunction(rawget(getfenv(anon), k), newcclosure(function(...)
                        if AimSettings.SilentAimV3Enabled then
                            local c = GetTargetV3()
                                      local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
                            local vel = tool and tool:GetAttribute("Velocity") or 1000
                                         if c and vel and tool and LP.Character and LP.Character:FindFirstChild("Head") then
                                local pos = c.Position
                                local tVel = c.AssemblyLinearVelocity
                                  local r = pos - LP.Character.Head.Position
                                 local v_vel = tVel - LP.Character.Head.AssemblyLinearVelocity
                                             local a = v_vel:Dot(v_vel) - vel * vel
                                 local b = 2 * r:Dot(v_vel)
                                        local c0 = r:Dot(r)
                                       local disc = b * b - 4 * a * c0
                                        if disc >= 0 then
                                         local sqrtDisc = math.sqrt(disc)
                                            local t1 = (-b - sqrtDisc) / (2 * a)
                                           local t2 = (-b + sqrtDisc) / (2 * a)
                                              local t_time = nil
                                            if t1 > 0 and t2 > 0 then t_time = math.min(t1, t2)
                                          elseif t1 > 0 then t_time = t1
                                             elseif t2 > 0 then t_time = t2 end
                                                if t_time then
                                                  local prediction = pos + tVel * t_time
                                                          return prediction + (prediction - LP.Character.Head.Position).Unit * (tool:GetAttribute("SpreadDefault") or 0) * 0.1
                                      end
                                        end
                                     return pos
                                         end
                           end
                          return oldCrosshair(...)
                     end))
                     elseif n == "bulletMagnetism" then
                       local oldMag
                      oldMag = hookfunction(rawget(getfenv(anon), k), newcclosure(function(...)
                                     if AimSettings.SilentAimV3Enabled then return nil end
                             return oldMag(...)
                      end))
                   end
             end
          end
     end
end

