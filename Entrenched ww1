		tool:SetAttribute("ProjectileGravity", Vector3.new(-32, -32, -32));
	end
	if GunSettings.SpreadEnabled then
		tool:SetAttribute("SpreadDefault", GunSettings.SpreadValue);
	end
	if GunSettings.ProjectilesEnabled then
