local function GetPing()
    local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    return (ping > 0 and ping / 1000) or 0.1
end

local function IsVisible(targetPart)
    if not LP.Character or not LP.Character:FindFirstChild("Head") then return false end
    local origin = LP.Character.Head.Position 
    local destination = targetPart.Position
    local direction = (destination - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {LP.Character, workspace.CurrentCamera}
    
    for i = 1, 4 do 
        raycastParams.FilterDescendantsInstances = ignoreList
        local result = workspace:Raycast(origin, direction, raycastParams)
        if result then
            local hit = result.Instance
            if hit:IsDescendantOf(targetPart.Parent) then return true end
            if hit.CanCollide == false then
                table.insert(ignoreList, hit)
            else return false end
        else return true end
    end
    return false 
end

local function GetTargetV2() 
    if AimSettings.StickyAimEnabled and CurrentStickyTarget then
        local hum = CurrentStickyTarget.Parent and CurrentStickyTarget.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(CurrentStickyTarget.Position)
            if onScreen then
                local center, _ = GetFOVCenter()
                local magnitude = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if magnitude < AimSettings.FOV then
                    local distToPlayer = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (LP.Character.HumanoidRootPart.Position - CurrentStickyTarget.Position).Magnitude) or 999
                    if distToPlayer <= AimSettings.MaxDistance then
                        if not AimSettings.WallCheck or IsVisible(CurrentStickyTarget) then
                            return CurrentStickyTarget
                        end
                    end
                end
            end
        end
        CurrentStickyTarget = nil
    end

    local target = nil
    local shortestDistance = AimSettings.FOV
    local center, _ = GetFOVCenter()

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= LP and v.Character and v.Character:FindFirstChild(AimSettings.TargetPart) then
            if v.Team == LP.Team then continue end
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            if not hum then continue end
            if AimSettings.DeadCheck and hum.Health <= 0 then continue end
            if AimSettings.ForcefieldCheck and v.Character:FindFirstChildOfClass("ForceField") then continue end

            local part = v.Character[AimSettings.TargetPart]
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local magnitude = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if magnitude < shortestDistance then
                    local distToPlayer = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (LP.Character.HumanoidRootPart.Position - part.Position).Magnitude) or 999
                    if distToPlayer <= AimSettings.MaxDistance then
                        if not AimSettings.WallCheck or IsVisible(part) then
                            shortestDistance = magnitude
                            target = part
                        end
                    end
                end
            end
        end
    end

    if target and AimSettings.StickyAimEnabled then
        CurrentStickyTarget = target
    end
    return target
end

local function GetAllyTargetInFOV()
    local target = nil
    local shortestDistance = AimSettings.FOV
    local center, _ = GetFOVCenter()

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= LP and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            if v.Team ~= LP.Team then continue end 
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            if not hum then continue end
            if AimSettings.DeadCheck and hum.Health <= 0 then continue end
            if hum.Health >= hum.MaxHealth then continue end
            if AimSettings.ForcefieldCheck and v.Character:FindFirstChildOfClass("ForceField") then continue end

            local part = v.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local magnitude = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if magnitude < shortestDistance then
                    local distToPlayer = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and (LP.Character.HumanoidRootPart.Position - part.Position).Magnitude) or 999
                    if distToPlayer <= MedicSettings.HealDistance then
                        shortestDistance = magnitude
                        target = part
                    end
                end
            end
        end
    end
    return target
end

