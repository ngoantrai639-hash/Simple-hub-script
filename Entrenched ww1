    tool:SetAttribute("ProjectileMaxDistance", GunSettings.MaxDistance)
  
    if GunSettings.SpreadEnabled then
        tool:SetAttribute("SpreadDefault", GunSettings.SpreadValue)
    end
    
    if GunSettings.AimFOVEnabled then
        tool:SetAttribute("aimFOV", GunSettings.AimFOVValue)
    end
    
    if GunSettings.AimFOVScopeEnabled then
        tool:SetAttribute("aimFOVScope", GunSettings.AimFOVScopeValue)
    end
end

