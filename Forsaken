local function ApplyJohnTrailESP()
    if not VisualSettings.JohnTrailESPEnabled then
        for part, box in pairs(CachedJohnTrails) do
            if box then box:Destroy() end
        end
        table.clear(CachedJohnTrails)
        return
    end

    local mapFolder = Workspace:FindFirstChild("Map")
    local ingameFolder = mapFolder and mapFolder:FindFirstChild("Ingame")
    if not ingameFolder then return end

    local currentKillerName = nil
    if CachedKillers then
        for _, k in ipairs(CachedKillers) do
            local uname = k:GetAttribute("Username")
            if uname and not isFakeKiller(k) then
                currentKillerName = uname
                break
            end
        end
    end

    if currentKillerName then
        local trailFolder = ingameFolder:FindFirstChild(currentKillerName .. "JohnDoeTrail")
        if trailFolder then
            for _, part in ipairs(trailFolder:GetChildren()) do
                if part:IsA("BasePart") then
                    if not CachedJohnTrails[part] then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "JohnTrailBox"
                        box.Adornee = part
                        box.Size = part.Size + Vector3_new(0.1, 0.1, 0.1)
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Transparency = 0.5
                        box.Color3 = VisualSettings.KillerColor
                        box.Parent = part
                        CachedJohnTrails[part] = box
                    else
                        CachedJohnTrails[part].Color3 = VisualSettings.KillerColor
                    end
                end
            end
        end
    end

    for part, box in pairs(CachedJohnTrails) do
        if not part or not part.Parent then
            if box then box:Destroy() end
            CachedJohnTrails[part] = nil
        end
    end
end

