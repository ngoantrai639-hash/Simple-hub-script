local function parseTimeToSeconds(timeStr)
    local m, s = string.match(timeStr, "(%d+):(%d+)")
    if m and s then
        return tonumber(m) * 60 + tonumber(s)
    end
    return -1
end

local function formatSecondsToTime(seconds)
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d", m, s)
end

local function createFloatingEffect(diffVal, isKiller, isIncrease)
    local floatLabel = CustomTimeLabel:Clone()
    local prefix = isIncrease and "+" or "-"
    floatLabel.Text = prefix .. formatSecondsToTime(math.abs(diffVal))
    
    if isIncrease then
        floatLabel.TextColor3 = isKiller and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    else
        floatLabel.TextColor3 = isKiller and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
    end
    
    floatLabel.Position = UDim2.new(0, math.random(60, 110), 0, math.random(-20, -5))
    floatLabel.Parent = CustomRoundFrame

    task.delay(1, function()
        local tween = TweenService:Create(floatLabel, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, floatLabel.Position.X.Offset, 0, floatLabel.Position.Y.Offset - 15),
            TextTransparency = 1,
            TextStrokeTransparency = 1
        })
        tween:Play()
        tween.Completed:Wait()
        floatLabel:Destroy()
    end)
end

NumberTweenValue.Changed:Connect(function(val)
    if isAnimating then
        CustomTimeLabel.Text = "Round time: " .. formatSecondsToTime(math.floor(val))
    end
end)

